   aLists.BorderBackground()->AppendToTop(&list);
 
+  // Zen notch scrolling (Solid Color): paint the obscured band above the
+  // root element in the page's top-edge color; it scrolls away with the
+  // canvas like real content.
+  if (const nscoord obscuredTop = zen::ObscuredTopInset(PresContext());
