# FullPanelKit fullscreen for browser windows. See ZenFullPanel.h and
# docs/zen-fullpanel/ in the Zen source tree.

DIRS += ["FullPanelKitCore"]

EXPORTS.mozilla += [
    "ZenFullPanel.h",
]

SOURCES += [
    "ZenFullPanel.mm",
]

LOCAL_INCLUDES += [
    "/widget",
    "/widget/cocoa",
    "FullPanelKitCore/include",
]

FINAL_LIBRARY = "xul"
